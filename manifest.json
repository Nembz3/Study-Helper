{
  "manifest_version": 3,
  "name": "Study Helper",
  "version": "2.0.0",
  "description": "Personal AI study helper with provider fallback.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://api.groq.com/*","https://generativelanguage.googleapis.com/*","https://openrouter.ai/*"],
  "background": {"service_worker":"background.js"},
  "action": {"default_popup":"popup.html","default_title":"Study Helper"}
}